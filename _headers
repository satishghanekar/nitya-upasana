# Cloudflare Pages response headers (https://developers.cloudflare.com/pages/configuration/headers/)
#
# Why: by default every file is re-checked with the server on every visit. Fonts never change in place,
# so phones can keep them for a year without asking; pictures for a week. The page, styles and scripts
# are always re-checked (no-cache = "ask first", not "don't store"), so an update reaches readers on
# their next visit, and the service worker (sw.js) keeps everything for offline use either way.
#
# If a font file is ever replaced, give it a new name (and update css/00-fonts.css and js/parts.js), because
# phones that already have the old one will not ask for it again.

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/*.webp
  Cache-Control: public, max-age=604800

/*.png
  Cache-Control: public, max-age=604800

/*.jpg
  Cache-Control: public, max-age=604800

/
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache

/css/*
  Cache-Control: no-cache

/js/*
  Cache-Control: no-cache

/content/*
  Cache-Control: no-cache

/sw.js
  Cache-Control: no-cache

/manifest.json
  Cache-Control: no-cache

# What a page may load (Content-Security-Policy): everything from this site, nothing from elsewhere. Scripts are never
# inline; styles may be, because the print view writes its own (a <style> and style attributes, js/features/print.js).
# Links to other sites (Wikipedia, WhatsApp) are ordinary links and not limited by it. tests/serve.mjs sends the same
# policy, so every test runs under it, and a file it blocks fails the tests (a console error).
/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; media-src 'self'; frame-src 'self' blob:; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'self'
